<Window xmlns="https://github.com/tuilib"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:TuiDemo"
        x:Class="TuiDemo.MainWindow"
        Title="{Binding Title}">

    <Window.Resources>
        <local:UpperCaseConverter x:Key="Upper"/>
    </Window.Resources>

    <DockPanel>

        <Border DockPanel.Dock="Top"
                BorderThickness="0,0,0,1"
                BorderBrush="Gray">

            <TextBlock Text="{Binding Title, Converter={StaticResource Upper}}"
                       FontStyles="Bold"
                       Foreground="Accent"
                       Margin="1,0"/>
        </Border>

        <TextBlock DockPanel.Dock="Bottom"
                   Text="{Binding Status}"
                   Foreground="Gray"
                   TextTrimming="CharacterEllipsis"
                   Margin="1,0"/>

        <Grid DockPanel.Dock="Bottom"
              ColumnDefinitions="*,Auto,Auto"
              ColumnSpacing="1"
              Margin="1,0,1,1">

            <TextBox x:Name="NewTodoBox"
                     Text="{Binding NewTitle}"
                     Watermark="New todo…"
                     KeyDown="OnNewTodoKeyDown"/>

            <Button Grid.Column="1"
                    Command="{Binding AddCommand}">Add</Button>

            <Button Grid.Column="2"
                    Click="OnRemoveClick">Remove</Button>
        </Grid>

        <Grid ColumnDefinitions="2*,3*"
              ColumnSpacing="1"
              Margin="1,1,1,0">

            <Border Title="Todos"
                    BorderThickness="1"
                    BorderBrush="Gray">

                <ListBox x:Name="TodoList"
                         ItemsSource="{Binding Todos}"
                         SelectedItem="{Binding SelectedTodo}"
                         ItemActivated="OnTodoActivated">

                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="local:TodoItem">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="1">

                                <TextBlock Text="{Binding Glyph}"/>

                                <TextBlock Text="{Binding Title}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Column="1"
                    Title="Details"
                    BorderThickness="1"
                    BorderBrush="Gray"
                    Padding="1,0">

                <StackPanel Spacing="1"
                            DataContext="{Binding SelectedTodo}">

                    <TextBox Text="{Binding Title}"
                             Watermark="Title"/>

                    <CheckBox IsChecked="{Binding IsDone}">Done</CheckBox>

                    <TextBlock Text="{Binding Progress, StringFormat='Progress: {0}%', FallbackValue='Nothing selected'}"/>

                    <ProgressBar Value="{Binding Progress}"
                                 ShowProgressText="True"/>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
